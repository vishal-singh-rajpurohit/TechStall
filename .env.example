# ==========================================
# Semantic E-Commerce Production Environment Template
# Copy to .env.docker.prod or .env before starting the production stack
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=semantic_ecommerce

# Backend FastAPI Settings
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
HF_TOKEN=your_huggingface_token_here

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Leave blank to use sandbox simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_51aBcDeFgHiJkL

# Main Customer Storefront (/)
FRONTEND_NEXTAUTH_URL=https://seller.vishalsingh.me
NEXT_PUBLIC_BACKEND_API_URL=https://seller.vishalsingh.me/api
NEXT_PUBLIC_API_URL=https://seller.vishalsingh.me/api/v1

# Seller / Admin Dashboard (/admin/)
SELLER_NEXTAUTH_URL=https://seller.vishalsingh.me/admin/api/auth
NEXT_PUBLIC_SELLER_API_URL=https://seller.vishalsingh.me/api/v1
NEXT_PUBLIC_STOREFRONT_URL=https://seller.vishalsingh.me

# Internal Server-to-Server Network URL (Docker network semantic_net_prod)
BACKEND_API_URL=http://backend:8000

# NextAuth Shared Authentication Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate_a_random_32_character_secret_here
